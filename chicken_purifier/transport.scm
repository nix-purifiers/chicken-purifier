;; Use HTTPS and retain the exact Henrietta response before native extraction.
(define purifier-responses '())
(define (purifier-response host locn)
  (when (get-environment-variable "CHICKEN_PURIFIER_FROZEN")
    (error "Frozen CHICKEN session cannot resolve dependencies; update the lock"))
  (unless (string=? host "code.call-cc.org")
    (error "purifier capture requires the canonical HTTPS egg registry" host))
  (let* ((file (create-temporary-file ".henrietta"))
         (url (string-append "https://" host locn))
         (code (system (string-append "@curl@/bin/curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --output " (qs* file 'unix) " " (qs* url 'unix)))))
    (unless (zero? code) (error "HTTPS egg download failed" url))
    (set! purifier-responses (cons (list url file) purifier-responses))
    file))
(define purifier-native-fetch http-fetch)
(define purifier-native-query http-query)
(define (purifier-active?)
  (or (get-environment-variable "CHICKEN_PURIFIER_CAPTURE")
      (get-environment-variable "CHICKEN_PURIFIER_FROZEN")))
(set! http-fetch
  (lambda (host port locn dest proxy-host proxy-port proxy-user-pass)
    (if (purifier-active?)
        (let ((file (purifier-response host locn)))
          (http-retrieve-files (open-input-file file) (open-output-string) dest))
        (purifier-native-fetch host port locn dest proxy-host proxy-port proxy-user-pass))))
(set! http-query
  (lambda (host port locn proxy-host proxy-port proxy-user-pass)
    (if (purifier-active?)
        (call-with-input-file (purifier-response host locn) (cut read-string #f <>))
        (purifier-native-query host port locn proxy-host proxy-port proxy-user-pass))))
(define (purifier-json value)
  (cond ((null? value) (display "[]"))
        ((pair? value)
         (display "[")
         (let loop ((xs value))
           (unless (null? xs)
             (purifier-json (car xs))
             (unless (null? (cdr xs)) (display ","))
             (loop (cdr xs))))
         (display "]"))
        ((not value) (display "null"))
        ((number? value) (write value))
        (else (write (->string value)))))
